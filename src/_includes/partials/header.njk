<header class="site-header">
  <!-- Top row: brand + search -->
  <div class="wrap header-top">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">
        <span class="spine"></span><span class="spine"></span><span class="spine"></span><span class="spine"></span>
      </span>
      <span class="brand-text">
        <span class="brand-name">Roaring Kids Press</span>
        <span class="brand-tag">{{ site.tagline }}</span>
      </span>
    </a>

    <div class="nav-search">
      <label class="visually-hidden" for="site-search">Search books</label>
      <input id="site-search" type="search" placeholder="Title / Series / ISBN / Author" autocomplete="off" />
      <button type="button" class="search-go" aria-label="Search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M10 4a6 6 0 1 1-4.2 10.2l-3.3 3.3-1.4-1.4 3.3-3.3A6 6 0 0 1 10 4m0 2a4 4 0 1 0 0 8 4 4 0 0 0 0-8"/></svg>
      </button>
      <ul id="search-results" class="search-results" role="listbox" hidden></ul>
    </div>

    <button class="nav-toggle" aria-controls="site-nav" aria-expanded="false" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <!-- Bottom row: nav -->
  <div class="wrap header-bottom">
    <nav id="site-nav" class="site-nav" aria-label="Primary">
      <ul class="nav-list">
        {% for item in site.nav %}
        {% set isActive = (page.url == item.url) %}
        {% if item.children %}
          {% for child in item.children %}
            {% if page.url == child.url %}{% set isActive = true %}{% endif %}
          {% endfor %}
        {% endif %}
        <li class="nav-item{% if item.children %} has-submenu{% endif %}">
          <a href="{{ item.url }}"{% if isActive %} aria-current="page"{% endif %}
             {% if item.children %}aria-haspopup="true" aria-expanded="false"{% endif %}>
            {{ item.text }}{% if item.children %}<span class="caret" aria-hidden="true">▾</span>{% endif %}
          </a>
          {% if item.children %}
          <ul class="submenu">
            {% for child in item.children %}
            <li><a href="{{ child.url }}"{% if page.url == child.url %} aria-current="page"{% endif %}>{{ child.text }}</a></li>
            {% endfor %}
          </ul>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
    </nav>
  </div>
</header>
