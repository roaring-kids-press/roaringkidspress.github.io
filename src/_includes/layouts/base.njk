<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{% if title %}{{ title }} · {{ site.name }}{% else %}{{ site.name }} - {{ site.tagline }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}" />
  <meta property="og:title" content="{% if title %}{{ title }} · {{ site.name }}{% else %}{{ site.name }}{% endif %}" />
  <meta property="og:description" content="{{ description or site.description }}" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,900&family=Nunito:wght@400;600;700&family=Space+Grotesk:wght@500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/assets/css/style.css" />
</head>
<body>
  {% include "partials/header.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  <script>
    // Mobile nav toggle
    document.querySelector('.nav-toggle')?.addEventListener('click', function () {
      const nav = document.getElementById('site-nav');
      const open = nav.classList.toggle('is-open');
      this.setAttribute('aria-expanded', open);
    });

    // On touch/mobile, let a tap open a submenu instead of following the link on first tap
    document.querySelectorAll('.has-submenu > a').forEach(function (a) {
      a.addEventListener('click', function (e) {
        if (window.matchMedia('(max-width: 800px)').matches) {
          const li = a.parentElement;
          const wasOpen = li.classList.contains('open');
          if (!wasOpen) { e.preventDefault(); li.classList.add('open'); a.setAttribute('aria-expanded', 'true'); }
        }
      });
    });

    // Mission slider: continuous cyclic auto-advance + per-slide timer bar + dots
    (function () {
      const root = document.querySelector('[data-slider]');
      if (!root) return;
      const slides = Array.from(root.querySelectorAll('[data-slide]'));
      const dots = Array.from(root.querySelectorAll('[data-dot]'));
      if (!slides.length) return;
      const DURATION = 3500;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      root.style.setProperty('--slide-ms', DURATION + 'ms');

      let current = 0;
      let timer = null;

      function show(i) {
        current = (i + slides.length) % slides.length;
        slides.forEach((s, n) => {
          const active = n === current;
          s.classList.toggle('is-active', active);
          s.setAttribute('aria-hidden', active ? 'false' : 'true');
        });
        dots.forEach((d, n) => {
          const active = n === current;
          d.classList.toggle('is-active', active);
          d.setAttribute('aria-selected', active ? 'true' : 'false');
          d.classList.remove('is-timing');
          d.querySelector('.dot-fill').style.width = '';
        });
        if (!reduce) {
          const fill = dots[current].querySelector('.dot-fill');
          void fill.offsetWidth; // reflow so the timer transition restarts
          dots[current].classList.add('is-timing');
        }
      }

      // Re-arm every cycle so it advances continuously and wraps around.
      function schedule() {
        if (reduce) return;
        clearTimeout(timer);
        timer = setTimeout(() => { show(current + 1); schedule(); }, DURATION);
      }
      function go(i) { show(i); schedule(); }

      // Dots jump to a slide and the continuous cycle keeps running from there.
      dots.forEach((d, n) => d.addEventListener('click', () => go(n)));

      // No hover pause — the slideshow runs continuously.

      show(0);
      schedule();
    })();
    // Works for any number of books by cloning the original set until the
    // track is wide enough to scroll and loop smoothly.
    (function () {
      const root = document.querySelector('[data-carousel]');
      if (!root) return;
      const viewport = root.querySelector('[data-carousel-viewport]');
      const track = root.querySelector('[data-carousel-track]');
      const prev = root.querySelector('.carousel-prev');
      const next = root.querySelector('.carousel-next');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const originals = Array.from(track.children);
      let setWidth = 0;   // width of ONE original set (the loop unit)

      // Measure one original set, then clone whole sets until the track is at
      // least ~3× the viewport so there's always room to scroll both ways.
      function build() {
        // remove any previous clones
        Array.from(track.querySelectorAll('[data-clone="true"]')).forEach(n => n.remove());
        // measure one set
        setWidth = originals.reduce((sum, el) => sum + el.getBoundingClientRect().width, 0);
        const gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap || '0') || 0;
        setWidth += gap * originals.length; // include the gap after each card
        const target = Math.max(viewport.clientWidth * 3, setWidth * 2);
        let width = setWidth;
        // append clones set-by-set until wide enough
        while (width < target) {
          originals.forEach(el => {
            const c = el.cloneNode(true);
            c.setAttribute('data-clone', 'true');
            c.setAttribute('aria-hidden', 'true');
            c.setAttribute('tabindex', '-1');
            track.appendChild(c);
          });
          width += setWidth;
        }
      }

      function wrap() {
        if (setWidth <= 0) return;
        if (viewport.scrollLeft >= setWidth) viewport.scrollLeft -= setWidth;
        else if (viewport.scrollLeft < 0) viewport.scrollLeft += setWidth;
      }

      let paused = false;
      let dragging = false;
      const pxPerSec = 32;   // constant speed regardless of display refresh rate
      let lastTs = null;
      let pos = 0;           // fractional source-of-truth for the scroll position

      function seatMiddle() { if (setWidth > 0) { viewport.scrollLeft = setWidth * 0.5; pos = viewport.scrollLeft; } }

      function init() {
        build();
        seatMiddle();
      }
      // build after layout settles
      requestAnimationFrame(() => requestAnimationFrame(init));
      window.addEventListener('load', init);
      let rz;
      window.addEventListener('resize', () => { clearTimeout(rz); rz = setTimeout(init, 200); });

      let wasStopped = true;
      let lastWritten = -1;    // last scrollLeft WE wrote (to ignore our own scroll events)
      function tick(ts) {
        if (lastTs == null) lastTs = ts;
        const dt = Math.min((ts - lastTs) / 1000, 0.1); // seconds, clamp long gaps
        lastTs = ts;
        const running = !reduce && !paused && !dragging;
        if (running) {
          if (wasStopped) { pos = viewport.scrollLeft; wasStopped = false; }
          pos += pxPerSec * dt;
          if (setWidth > 0) {
            if (pos >= setWidth) pos -= setWidth;
            else if (pos < 0) pos += setWidth;
          }
          viewport.scrollLeft = pos;
          lastWritten = viewport.scrollLeft;   // read back the rounded value
        } else {
          wasStopped = true;
        }
        requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);

      function armPause(ms) {
        paused = true;
        clearTimeout(armPause._t);
        armPause._t = setTimeout(() => { paused = false; }, ms);
      }
      function cardStep() {
        const c = track.querySelector('.carousel-card');
        return (c ? c.offsetWidth + 26 : 220) * 2;
      }
      prev.addEventListener('click', () => {
        armPause(700);
        const step = cardStep();
        // If we're near the start, jump forward one whole set first (seamless,
        // since content repeats) so there's room to smooth-scroll left into.
        if (setWidth > 0 && viewport.scrollLeft < step) {
          viewport.scrollLeft += setWidth;
        }
        viewport.scrollBy({ left: -step, behavior: 'smooth' });
        setTimeout(wrap, 450);
      });
      next.addEventListener('click', () => {
        armPause(700);
        const step = cardStep();
        // Symmetric guard for the far end.
        if (setWidth > 0 && viewport.scrollLeft > viewport.scrollWidth - viewport.clientWidth - step) {
          viewport.scrollLeft -= setWidth;
        }
        viewport.scrollBy({ left: step, behavior: 'smooth' });
        setTimeout(wrap, 450);
      });

      // Drag / swipe (mouse + touch), direction-aware so a vertical page
      // scroll on mobile is NOT hijacked as a horizontal drag.
      let startX = 0, startY = 0, startScroll = 0, moved = false, axis = null;
      viewport.addEventListener('pointerdown', (e) => {
        // Only left mouse button / touch / pen
        if (e.pointerType === 'mouse' && e.button !== 0) return;
        dragging = true; moved = false; axis = null;
        startX = e.clientX; startY = e.clientY; startScroll = viewport.scrollLeft;
        viewport.classList.add('is-dragging');
      });
      viewport.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        const dx = e.clientX - startX;
        const dy = e.clientY - startY;
        // Decide the gesture axis once, after a small threshold.
        if (axis === null && (Math.abs(dx) > 6 || Math.abs(dy) > 6)) {
          axis = Math.abs(dx) > Math.abs(dy) ? 'x' : 'y';
          if (axis === 'x') {
            // Now that we know it's a horizontal drag, capture the pointer.
            try { viewport.setPointerCapture(e.pointerId); } catch (_) {}
          } else {
            // Vertical intent → release the gesture so the PAGE scrolls,
            // and don't touch scrollLeft (this fixes the mobile "restart").
            dragging = false;
            viewport.classList.remove('is-dragging');
            return;
          }
        }
        if (axis !== 'x') return;
        e.preventDefault();
        if (Math.abs(dx) > 4) moved = true;
        let target = startScroll - dx;
        if (setWidth > 0) {
          while (target >= setWidth) { target -= setWidth; startScroll -= setWidth; }
          while (target < 0)         { target += setWidth; startScroll += setWidth; }
        }
        viewport.scrollLeft = target;
      });
      function endDrag(e) {
        if (!dragging && axis !== 'x') { axis = null; return; }
        dragging = false; axis = null;
        viewport.classList.remove('is-dragging');
        try { viewport.releasePointerCapture(e.pointerId); } catch (_) {}
        wrap();
        armPause(500);
      }
      viewport.addEventListener('pointerup', endDrag);
      viewport.addEventListener('pointercancel', endDrag);

      // Native scroll wrap: trackpad two-finger swipes and touch momentum produce
      // real scroll events (not pointer drags). Without this, scrolling toward 0
      // hits the left wall and "sticks" (desktop right-swipe bug). We keep the
      // position inside [0, setWidth) so it loops seamlessly in BOTH directions.
      let scrollWrapRAF = null;
      viewport.addEventListener('scroll', () => {
        // Ignore scroll events caused by our own auto-scroll writes.
        if (Math.abs(viewport.scrollLeft - lastWritten) < 2) return;
        if (dragging) return;              // drag handler manages its own wrapping
        if (scrollWrapRAF) return;
        scrollWrapRAF = requestAnimationFrame(() => {
          scrollWrapRAF = null;
          if (setWidth <= 0) return;
          const buffer = setWidth * 0.25;
          if (viewport.scrollLeft < buffer) {
            viewport.scrollLeft += setWidth;
          } else if (viewport.scrollLeft > setWidth + buffer) {
            viewport.scrollLeft -= setWidth;
          }
          armPause(400);   // real user scroll → brief auto-scroll pause
        });
      }, { passive: true });

      track.addEventListener('click', (e) => { if (moved) { e.preventDefault(); moved = false; } }, true);
      track.addEventListener('dragstart', (e) => e.preventDefault());
    })();
    (function () {
      const input = document.getElementById('site-search');
      const results = document.getElementById('search-results');
      if (!input) return;
      let index = [];
      let loaded = false;
      async function load() {
        if (loaded) return;
        try {
          const res = await fetch('/search-index.json');
          index = await res.json();
          loaded = true;
        } catch (e) { /* index not built yet */ }
      }
      function render(matches) {
        if (!matches.length) { results.hidden = true; results.innerHTML = ''; return; }
        results.innerHTML = matches.slice(0, 8).map(function (b) {
          return '<li role="option"><a href="' + b.url + '">' +
            '<span class="r-title">' + b.title + '</span>' +
            '<span class="r-meta">' + b.series + (b.isbn ? ' · ' + b.isbn : '') + '</span></a></li>';
        }).join('');
        results.hidden = false;
      }
      function search(q) {
        q = q.trim().toLowerCase();
        if (!q) { results.hidden = true; results.innerHTML = ''; return; }
        const m = index.filter(function (b) {
          return [b.title, b.series, b.author, b.isbn].join(' ').toLowerCase().indexOf(q) !== -1;
        });
        render(m);
      }
      input.addEventListener('focus', load);
      input.addEventListener('input', function () { search(input.value); });
      input.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') {
          const first = results.querySelector('a');
          if (first) window.location.href = first.getAttribute('href');
        }
        if (e.key === 'Escape') { results.hidden = true; }
      });
      document.addEventListener('click', function (e) {
        if (!e.target.closest('.nav-search')) { results.hidden = true; }
      });
    })();
  </script>
</body>
</html>
